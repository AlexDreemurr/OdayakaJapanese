# VOICEVOX TTS endpoint used by the browser.
# Public base path for the built frontend.
# Custom domain root:
VITE_BASE_PATH=/
# GitHub project page:
# VITE_BASE_PATH=/HappyJPGrammar/

# Local development usually uses:
VITE_TTS_ENDPOINT=http://localhost:8787/tts

# Public deployment should use your tunnel/domain endpoint, for example:
# VITE_TTS_ENDPOINT=https://tts.你的域名.com/tts

# Origin allowed by the local Node TTS proxy.
# Local development can use:
TTS_CORS_ORIGIN=http://localhost:5173

# Production should use the real frontend origin, for example:
# TTS_CORS_ORIGIN=https://你的前端域名.com

# If your frontend has both www and non-www domains, the current proxy code
# only documents one origin here. Use the exact frontend origin that users
# actually open in the browser.
